# =============================================================================
# Terraform Variables Template
# =============================================================================
# Copy this file to terraform.tfvars and fill in your actual values
#
# Usage:
#   1. Copy: cp terraform.tfvars.template terraform.tfvars
#   2. Edit terraform.tfvars with your actual configuration values
#   3. Run: terraform init && terraform apply
#
# Security Note:
#   - Never commit terraform.tfvars to version control
#   - This file contains sensitive values (passwords, API keys, etc.)
#   - The .gitignore file is configured to exclude terraform.tfvars
# =============================================================================

# =============================================================================
# GCP PROJECT CONFIGURATION
# =============================================================================
project_id  = "your-gcp-project-id"
region      = "us-central1"  # Change to your preferred GCP region
environment = "dev"  # Change to your environment (dev, staging, prod)

# =============================================================================
# PUSHER CONFIGURATION
# =============================================================================
# Get these values from your Pusher dashboard
pusher_key     = "your-pusher-api-key"
pusher_app_id  = "your-pusher-app-id"
pusher_cluster = "your-pusher-cluster-region"
pusher_secret  = "your-pusher-secret"

# =============================================================================
# SMTP CONFIGURATION
# =============================================================================
# Email service credentials for notifications
smtp_password = "your-smtp-password"
smtp_username = "your-smtp-username"

# =============================================================================
# NEO4J DATABASE CONFIGURATION
# =============================================================================
# Neo4j database configuration
# Note: Neo4j is deployed by Terraform. The Bolt URI is automatically generated
# from the deployed instance's IP address and stored in Secret Manager.
neo4j_password = "your-neo4j-password"  # Initial password for Neo4j admin user
neo4j_username = "neo4j"                 # Username for Neo4j (default: "neo4j")
neo4j_db_name  = "neo4j"                # Database name (default: "neo4j")

# =============================================================================
# GCP SERVICE ACCOUNT
# =============================================================================
# Path to your GCP service account JSON key file
credentials_file = "path/to/your/service-account-key.json"

# =============================================================================
# VPC NETWORK CONFIGURATION
# =============================================================================
vpc_name    = "your-vpc-name"
subnet_cidr = "10.0.0.0/24"  # Change to your preferred subnet CIDR

# =============================================================================
# RESOURCE LABELS
# =============================================================================
labels = {
  environment = "dev"  # Change to match your environment
  project     = "your-project-name"
  team        = "your-team-name"
}

# =============================================================================
# AUTH0 CONFIGURATION
# =============================================================================
# Auth0 application settings
auth0_domain = "your-tenant.auth0.com"
auth0_audience = "https://api.your-domain.com"
auth0_client_id = "your-auth0-client-id"
auth0_client_secret = "your-auth0-client-secret"

# Auth0 Management API settings (required for admin features like user account deletion)
auth0_management_api_client_id = "your-management-api-client-id"
auth0_management_api_client_secret = "your-management-api-client-secret"
auth0_management_api_audience = "https://api.your-domain.com"
auth0_management_api_domain = "your-tenant.auth0.com"

# Auth0 UI Configuration (required for user interface service)
auth0_redirect_uri = "https://app.your-domain.com/callback"  # OAuth callback URL
auth0_error_path = "/error"  # Path for Auth0 error handling
auth0_app_uri = "https://app.your-domain.com"  # Your application URI
auth0_api_uri = "https://api.your-domain.com"  # Your API URI

# =============================================================================
# CUSTOM DOMAIN CONFIGURATION (DEPRECATED)
# =============================================================================
# Domain mapping is no longer managed by Terraform.
# Set up domain mappings manually in GCP Console after deployment.
# See GCP/DOMAIN_SETUP.md for manual domain mapping instructions.
# The domain_name variable is kept for backwards compatibility but is not used.
# domain_name = null

# =============================================================================
# CONTAINER IMAGE CONFIGURATION
# =============================================================================
# Container images for each service (optional - defaults are provided)
# Uncomment and modify if you need to use custom images
# page_builder_image = "docker.io/deepthought42/page-builder:latest"
# api_image = "docker.io/deepthought42/crawler-api:latest"
# audit_manager_image = "docker.io/deepthought42/audit-manager:latest"
# audit_service_image = "docker.io/deepthought42/audit-update-service:latest"
# journey_executor_image = "docker.io/deepthought42/journey-executor:latest"
# journey_expander_image = "docker.io/deepthought42/journey-expander:latest"
# content_audit_image = "docker.io/deepthought42/content-audit:latest"
# visual_design_audit_image = "docker.io/deepthought42/visual-design-audit:latest"
# information_architecture_audit_image = "docker.io/deepthought42/information-architecture-audit:latest"
# user_interface_image = "docker.io/deepthought42/user-interface:latest"
# selenium_version is configured in the SELENIUM CONFIGURATION section below

# =============================================================================
# SELENIUM CONFIGURATION
# =============================================================================
# Selenium standalone Chrome Docker image version/tag
# Image will be: docker.io/selenium/standalone-chrome:{version}
# Options:
#   - "latest" (always latest version)
#   - "4.15.0" (specific Selenium Grid 4.x version - recommended for production)
#   - "3.141.59" (older version - not recommended)
selenium_version = "latest"

# Number of Selenium instances to create
selenium_instance_count = 1  # Increase for higher load handling

# Maximum concurrent sessions per Selenium instance
# Total concurrent sessions = selenium_instance_count × selenium_max_sessions
# Example: 10 instances × 4 sessions = 40 total concurrent sessions
selenium_max_sessions = 1  # Default is 1, increase based on instance resources